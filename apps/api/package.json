{
  "name": "@reli-core/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",

    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",

    "test": "vitest run",
    "test:watch": "vitest",

    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",

    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "eslint-config-prettier": "^10.1.8",
    "@typescript-eslint/parser": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",

    "vitest": "^4.0.18",
    "supertest": "^7.2.2",
    "@types/supertest": "^6.0.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}    
