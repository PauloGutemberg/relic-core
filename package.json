{
  "name": "reli-core",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run -w apps/api dev",
    "dev:web": "npm run -w apps/web dev",

    "build": "npm run -w apps/api build && npm run -w apps/web build",
    "start": "npm run -w apps/web start",

    "lint": "npm run -ws --if-present lint",
    "test": "npm run -ws --if-present test",
    "typecheck": "npm run -ws --if-present typecheck",

    "format": "npm run -ws --if-present format",
    "format:check": "npm run -ws --if-present format:check"
  }
}
